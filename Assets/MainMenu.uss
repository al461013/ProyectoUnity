.full-screen {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/menu/PantallaInicial.png?fileID=-6237960843470122227&guid=9c08fdeda3ca37741a3ee87115a8b9ed&type=3#PantallaInicial_0");
    background-size: cover;
    background-position: center;
}

.menu-container {
    width: 300px;
    height: 60%;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
}

.menu-button {
    width: auto;
    height: auto;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#btnPlay {
    background-image: url("menu/JUGAR.png");
    left: 160%;
    width: 300px;
    height: 200px;
    background-position-y: bottom 0;
    background-position-x: right 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-type: sliced;
    top: 380px;
    margin-top: 0;
    margin-bottom: 199px;
}

#btnOptions {
    background-image: url("menu/Ajustes.png");
    width: 300px;
    left: 160%;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom 0;
    top: 220px;
}

#btnExit {
    background-image: url("menu/Exit.png");
    width: 300px;
    left: 160%;
    height: 200px;
    position: relative;
    background-position-y: center;
    top: 193px;
    margin-bottom: 0;
}

.menu-button {
    transition: scale 0.1s;
}

.menu-button:hover {
    scale: 1.1;
}
